  "subject": "math",
  "title": "Math · Kinder 2",
  "topics": [
    {
      "topicId": "k2-counting",
      "title": "Counting to 20",
      "icon": "🔢",
      "summary": "Count objects, and know which number comes next.",
      "skills": [
        {
          "skillId": "k2-count-10",
          "title": "Count to 10",
          "lesson": {
            "steps": [
              {
                "stage": "concrete",
                "text": "Let's count! Tap each apple. Say the number as you tap.",
                "interact": {
                  "kind": "tapCount",
                  "emoji": "🍎",
                  "count": 5
                }
              },
              {
                "stage": "pictorial",
                "text": "A ten frame has 10 boxes. Each dot fills one box. Count the dots: there are 7.",
                "visual": {
                  "kind": "tenFrames",
                  "value": 7
                }
              },
              {
                "stage": "try",
                "text": "Your turn! Tap the boxes to show 6.",
                "interact": {
                  "kind": "fillFrame",
                  "target": 6
                }
              },
              {
                "stage": "abstract",
                "text": "How many stars? Count them, then tap the number.",
                "interact": {
                  "kind": "check",
                  "prompt": "How many stars?",
                  "visual": {
                    "kind": "pictures",
                    "emoji": "⭐",
                    "count": 8
                  },
                  "choices": [
                    "7",
                    "8",
                    "9"
                  ],
                  "answer": "8",
                  "explain": "There are 8 stars."
                }
              }
            ]
          },
          "generator": {
            "type": "countPictures",
            "max": 10
          }
        },
        {
          "skillId": "k2-count-20",
          "title": "Count to 20",
          "lesson": {
            "steps": [
              {
                "stage": "concrete",
                "text": "When there are more than 10, fill a whole ten frame first. Ten, and 3 more, makes 13.",
                "visual": {
                  "kind": "tenFrames",
                  "value": 13
                }
              },
              {
                "stage": "try",
                "text": "Your turn! Fill the boxes to show 14. Fill one whole ten frame, then 4 more.",
                "interact": {
                  "kind": "fillFrame",
                  "target": 14
                }
              },
              {
                "stage": "pictorial",
                "text": "Count in fives to go faster: 5, 10, 15. Then 16, 17.",
                "visual": {
                  "kind": "pictures",
                  "emoji": "🐟",
                  "count": 17
                }
              },
              {
                "stage": "abstract",
                "text": "Ten and 6 more. How many?",
                "interact": {
                  "kind": "check",
                  "prompt": "10 and 6 more is…",
                  "visual": {
                    "kind": "tenFrames",
                    "value": 16
                  },
                  "choices": [
                    "15",
                    "16",
                    "17"
                  ],
                  "answer": "16",
                  "explain": "10 and 6 make 16."
                }
              }
            ]
          },
          "generator": {
            "type": "countPictures",
            "max": 20
          }
        },
        {
          "skillId": "k2-number-order",
          "title": "What comes next?",
          "lesson": {
            "steps": [
              {
                "stage": "pictorial",
                "text": "Numbers go in order on a number line. After 4 comes 5. Each jump is one more.",
                "visual": {
                  "kind": "jumps",
                  "from": 1,
                  "step": 1,
                  "count": 5
                }
              },
              {
                "stage": "abstract",
                "text": "The number after is one more. The number before is one less.",
                "interact": {
                  "kind": "check",
                  "prompt": "What number comes after 6?",
                  "visual": {
                    "kind": "numberLine",
                    "from": 3,
                    "to": 9,
                    "mark": 6
                  },
                  "choices": [
                    "5",
                    "7",
                    "8"
                  ],
                  "answer": "7",
                  "explain": "One more than 6 is 7."
                }
              }
            ]
          },
          "generator": {
            "type": "numberOrder",
            "max": 20
          }
        }
      ]
    },
    {
      "topicId": "k2-compare",
      "title": "More and fewer",
      "icon": "⚖️",
      "summary": "Find which group has more.",
      "skills": [
        {
          "skillId": "k2-more-fewer",
          "title": "More or fewer",
          "lesson": {
            "steps": [
              {
                "stage": "concrete",
                "text": "Line them up, one under the other. The row that sticks out has more.",
                "visual": {
                  "kind": "pictureRows",
                  "rows": [
                    {
                      "emoji": "🚗",
                      "count": 6
                    },
                    {
                      "emoji": "🎈",
                      "count": 4
                    }
                  ]
                }
              },
              {
                "stage": "abstract",
                "text": "6 cars and 4 balloons. 6 is more than 4. 4 is fewer than 6.",
                "interact": {
                  "kind": "check",
                  "prompt": "Which has more?",
                  "visual": {
                    "kind": "pictureRows",
                    "rows": [
                      {
                        "emoji": "🐟",
                        "count": 3
                      },
                      {
                        "emoji": "🌸",
                        "count": 7
                      }
                    ]
                  },
                  "choices": [
                    "🐟",
                    "🌸"
                  ],
                  "answer": "🌸",
                  "explain": "7 flowers is more than 3 fish."
                }
              }
            ]
          },
          "generator": {
            "type": "moreOrFewer",
            "max": 10
          }
        }
      ]
    },
    {
      "topicId": "k2-shapes",
      "title": "Shapes",
      "icon": "🔺",
      "summary": "Name circles, squares, triangles and more.",
      "skills": [
        {
          "skillId": "k2-shapes-basic",
          "title": "Circle, square, triangle, rectangle",
          "lesson": {
            "steps": [
              {
                "stage": "pictorial",
                "text": "A circle is round. It has no corners.",
                "visual": {
                  "kind": "shape",
                  "shape": "circle"
                }
              },
              {
                "stage": "pictorial",
                "text": "A triangle has 3 sides and 3 corners.",
                "visual": {
                  "kind": "shape",
                  "shape": "triangle"
                }
              },
              {
                "stage": "pictorial",
                "text": "A square has 4 sides that are all the same length.",
                "visual": {
                  "kind": "shape",
                  "shape": "square"
                }
              },
              {
                "stage": "pictorial",
                "text": "A rectangle has 4 sides too. Two are long and two are short.",
                "visual": {
                  "kind": "shape",
                  "shape": "rectangle"
                }
              },
              {
                "stage": "try",
                "text": "Which shape has 3 corners?",
                "interact": {
                  "kind": "check",
                  "prompt": "Which shape has 3 corners?",
                  "choices": [
                    "circle",
                    "triangle",
                    "square"
                  ],
                  "answer": "triangle",
                  "explain": "A triangle has 3 corners."
                }
              }
            ]
          },
          "generator": {
            "type": "shapes",
            "set": [
              "circle",
              "square",
              "triangle",
              "rectangle"
            ]
          }
        },
