    {
      "topicId": "k2-adding",
      "title": "Adding",
      "icon": "➕",
      "summary": "Put groups together and count them all.",
      "skills": [
        {
          "skillId": "k2-add-5",
          "title": "Add within 5",
          "lesson": {
            "steps": [
              {
                "stage": "concrete",
                "text": "Adding means putting groups together. Watch!",
                "interact": {
                  "kind": "worked",
                  "method": {
                    "kind": "countAll",
                    "emoji": "🐥",
                    "a": 2,
                    "b": 1
                  }
                }
              },
              {
                "stage": "pictorial",
                "text": "A number bond shows the parts and the whole. 3 and 2 make 5.",
                "visual": {
                  "kind": "bond",
                  "whole": 5,
                  "parts": [
                    3,
                    2
                  ]
                }
              },
              {
                "stage": "try",
                "text": "Your turn! 3 balloons and 2 more.",
                "interact": {
                  "kind": "tryIt",
                  "method": {
                    "kind": "countAll",
                    "emoji": "🎈",
                    "a": 3,
                    "b": 2
                  }
                }
              },
              {
                "stage": "abstract",
                "text": "We write it like this: 3 + 2 = 5."
              }
            ]
          },
          "generator": {
            "type": "addPictures",
            "max": 5
          }
        },
        {
          "skillId": "k2-add-10",
          "title": "Add within 10",
          "lesson": {
            "steps": [
              {
                "stage": "concrete",
                "text": "Start with the bigger group and count on. Watch the jumps!",
                "interact": {
                  "kind": "worked",
                  "method": {
                    "kind": "countOn",
                    "a": 6,
                    "b": 3
                  }
