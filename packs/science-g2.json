                  "kind": "letters",
                  "emoji": "🐶 🐔 🐟 🐜",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Mammals have fur and feed their babies milk. Birds have feathers and beaks. Fish live in water and breathe with gills. Insects have six legs."
              },
              {
                "stage": "apply",
                "text": "Your turn: Which animal group does it belong to?",
                "interact": {
                  "kind": "check",
                  "prompt": "Which animal group does it belong to?",
