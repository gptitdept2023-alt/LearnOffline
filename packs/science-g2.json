    {
      "topicId": "sci2-plants",
      "title": "How plants grow",
      "icon": "🌱",
      "summary": "What plants need, from seed to plant, and how we use plants.",
      "skills": [
        {
          "skillId": "sci2-plant-needs",
          "title": "What plants need",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Grow two bean seeds. Keep one in the light and one in a dark box. After a week, the one in the dark is pale, thin and weak.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🌱 📦",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Plants need sunlight, water, air and space to grow. They make their own food in their leaves.",
                "visual": {
                  "kind": "letters",
                  "emoji": "☀️ 💧 💨",
                  "label": "a picture"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: Which plant will grow best?",
                "interact": {
                  "kind": "check",
                  "prompt": "Which plant will grow best?",
                  "choices": [
                    "one with sunlight, water and space",
                    "one in a closed box with no light",
                    "one that is never watered"
                  ],
                  "answer": "one with sunlight, water and space",
                  "explain": "A plant grows best when it gets all it needs."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "plantNeeds"
          }
        },
        {
          "skillId": "sci2-seed",
          "title": "From seed to plant",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Soak a bean seed and watch it each day. First a root pokes out, then a shoot with tiny leaves.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🌰 🌱",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "A seed grows into a seedling, then a young plant, then an adult plant with flowers. The flowers make pods with new seeds.",
                "visual": {
                  "kind": "letters",
                  "text": "seed → seedling → plant → flowers → seeds",
                  "label": "seed → seedling → plant → flowers → seeds"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: In the life cycle of a bean plant, what comes just before \"a seed\"?",
                "interact": {
                  "kind": "check",
                  "prompt": "In the life cycle of a bean plant, what comes just before \"a seed\"?",
                  "visual": {
                    "kind": "letters",
                    "emoji": "🌱",
                    "label": "the life cycle of a bean plant"
                  },
                  "choices": [
                    "a young plant",
                    "the seed sprouts a root",
                    "a seedling with small leaves",
                    "pods with new seeds"
                  ],
                  "answer": "pods with new seeds",
                  "explain": "The life cycle of a bean plant: a seed → the seed sprouts a root → a seedling with small leaves → a young plant → an adult plant with flowers → pods with new seeds, and then it starts again. The new seeds can grow into new bean plants."
                }
              }
            ]
          },
          "generator": {
            "type": "sciOrder",
            "seqs": [
              "beanPlant"
            ]
          }
        },
