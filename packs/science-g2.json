                  },
                  "choices": [
                    "bird",
                    "mammal",
                    "fish",
                    "insect"
                  ],
                  "answer": "mammal",
                  "explain": "A horse is a mammal: it has hair or fur and feeds its young on milk."
                }
              }
            ]
          },
