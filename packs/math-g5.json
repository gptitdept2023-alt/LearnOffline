          "title": "Multiply by 10, 100 and 1,000",
          "lesson": {
            "steps": [
              {
                "stage": "concrete",
                "text": "10 tens make 100. Multiplying by 10 makes every digit worth 10 times as much."
              },
              {
                "stage": "pictorial",
                "text": "× 10: each digit moves 1 place to the left. × 100: 2 places. × 1,000: 3 places. Empty places get a 0."
              },
              {
                "stage": "abstract",
                "text": "36 × 100 = 3,600. 36 × 1,000 = 36,000."
              },
