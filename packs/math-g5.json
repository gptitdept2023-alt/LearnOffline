          "lesson": {
            "steps": [
              {
                "stage": "pictorial",
                "text": "Group the digits in threes from the right. 4,250,000 is 4 millions, 250 thousands."
              },
              {
                "stage": "abstract",
                "text": "In 4,250,000 the 4 is in the millions place, so it stands for 4,000,000."
