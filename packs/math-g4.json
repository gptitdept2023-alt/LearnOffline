      "title": "Factors and multiples",
      "icon": "🧮",
      "summary": "Find factors and multiples of whole numbers.",
      "skills": [
        {
          "skillId": "g4-factors-multiples",
          "title": "Factors and multiples",
          "lesson": {
            "steps": [
              {
                "stage": "concrete",
                "text": "Arrange 12 counters in equal rows. 3 rows of 4 works, so 3 and 4 are factors of 12.",
                "visual": {
                  "kind": "groups",
                  "groups": 3,
                  "each": 4
                }
              },
              {
                "stage": "abstract",
                "text": "Factors of 12: 1, 2, 3, 4, 6, 12.\nMultiples of 4: 4, 8, 12, 16, 20, …",
                "interact": {
                  "kind": "check",
                  "prompt": "Which number is a factor of 12?",
                  "choices": [
                    "5",
                    "6",
                    "7",
                    "8"
                  ],
                  "answer": "6",
                  "explain": "12 ÷ 6 = 2 exactly, so 6 is a factor."
                }
              }
            ]
          },
          "generator": {
            "type": "factorsMultiples",
            "max": 72
          }
        }
      ]
    },
