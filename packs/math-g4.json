      "topicId": "g4-whole-numbers",
      "title": "Whole numbers to 100,000",
      "icon": "🔢",
      "summary": "Place value, reading and comparing large numbers.",
      "skills": [
        {
          "skillId": "g4-place-value",
          "title": "Place value to ten thousands",
          "lesson": {
            "steps": [
              {
                "stage": "concrete",
                "text": "Base-ten blocks: a flat is 100, a rod is 10, a cube is 1. This shows 243.",
                "visual": {
                  "kind": "blocks",
                  "value": 243
                }
              },
              {
                "stage": "pictorial",
                "text": "Each place is 10 times the place on its right:\nones → tens → hundreds → thousands → ten thousands."
              },
              {
                "stage": "abstract",
                "text": "In 47,352 the 4 is in the ten thousands place, so it stands for 40,000.",
                "interact": {
                  "kind": "check",
                  "prompt": "In 47,352, what value does the 7 stand for?",
                  "choices": [
                    "7",
                    "70",
                    "700",
                    "7,000"
                  ],
                  "answer": "7,000",
                  "explain": "The 7 is in the thousands place: 7,000."
                }
              }
            ]
          },
          "generator": {
            "type": "placeValue",
            "digits": 5
          }
        },
        {
          "skillId": "g4-compare",
          "title": "Compare numbers",
          "lesson": {
            "steps": [
              {
                "stage": "pictorial",
                "text": "Line the numbers up by place value:\n38,415\n38,154"
              },
              {
                "stage": "abstract",
                "text": "Start from the left. 3 = 3, 8 = 8, then 4 > 1. The first place that differs decides.",
                "interact": {
                  "kind": "check",
                  "prompt": "Which number is greater?",
                  "choices": [
                    "38,415",
                    "38,154"
                  ],
                  "answer": "38,415",
                  "explain": "In the hundreds, 4 is greater than 1."
                }
              }
            ]
          },
          "generator": {
            "type": "compare",
            "min": 10000,
            "max": 99999
          }
        },
        {
          "skillId": "g4-add-sub",
          "title": "Add and subtract 4-digit numbers",
          "lesson": {
            "steps": [
              {
                "stage": "technique",
                "text": "Column addition: add each place, starting from the ones. Carry when a place makes 10 or more.",
                "interact": {
                  "kind": "worked",
                  "method": {
                    "kind": "columnAdd",
                    "a": 4568,
                    "b": 2775
                  }
                }
              },
              {
                "stage": "technique",
                "text": "Column subtraction: when the top digit is too small, rename 1 from the next place.",
                "interact": {
                  "kind": "worked",
                  "method": {
                    "kind": "columnSub",
                    "a": 6302,
                    "b": 2748
                  }
                }
              },
              {
                "stage": "try",
                "text": "Your turn: 3,456 + 1,879.",
                "interact": {
                  "kind": "tryIt",
                  "method": {
                    "kind": "columnAdd",
                    "a": 3456,
                    "b": 1879
                  }
                }
              }
            ]
          },
          "generator": {
            "type": "addition",
            "min": 1000,
            "max": 4999,
            "regroup": true
          },
          "questions": [
            {
              "id": "g4-as-1",
              "type": "numeric",
              "prompt": "6,302 − 2,748 = ?",
              "answer": 3554,
              "hint": "You need to rename across the zero: 6,302 = 62 hundreds + 10 tens… take it one place at a time.",
              "explain": "6,302 − 2,748 = 3,554",
              "method": {
                "kind": "columnSub",
                "a": 6302,
                "b": 2748
              }
            },
            {
              "id": "g4-as-2",
              "type": "numeric",
              "prompt": "9,000 − 4,567 = ?",
              "answer": 4433,
              "hint": "Think 8,999 + 1. Subtract from 8,999 first, then add 1.",
              "explain": "8,999 − 4,567 = 4,432, plus 1 = 4,433",
              "method": {
                "kind": "columnSub",
                "a": 9000,
                "b": 4567
              }
            }
          ]
        }
