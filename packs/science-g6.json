  "topics": [
    {
      "topicId": "sci6-energy",
      "title": "Energy",
      "icon": "⚡",
      "summary": "Forms of energy, energy changes and photosynthesis.",
      "skills": [
        {
          "skillId": "sci6-energy-forms",
          "title": "Forms of energy",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Stretch a rubber band and let go. Lift a book onto a shelf. Eat a banana. Where is the energy in each?",
                "visual": {
                  "kind": "letters",
                  "emoji": "🪢 📚 🍌",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Kinetic energy is the energy of moving things. Potential energy is stored: by height, by stretching, or as chemicals in food and batteries. Light, heat, sound and electrical energy are other forms."
              },
              {
                "stage": "apply",
                "text": "Your turn: Where do animals get their energy from?",
                "interact": {
                  "kind": "check",
                  "prompt": "Where do animals get their energy from?",
                  "choices": [
                    "the food they eat",
                    "the air only",
                    "the water they drink"
                  ],
                  "answer": "the food they eat",
                  "explain": "Food stores chemical energy that animals use."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "energyForms"
          }
        },
        {
          "skillId": "sci6-energy-change",
          "title": "Energy changes",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Switch on a torch. Feel the bulb after a minute: it is warm.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🔦",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Energy is never made or destroyed; it changes form. In a torch: chemical (battery) → electrical → light and heat.",
                "visual": {
                  "kind": "letters",
                  "text": "chemical → electrical → light + heat",
                  "label": "chemical → electrical → light + heat"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: Green plants change light energy into…",
                "interact": {
                  "kind": "check",
                  "prompt": "Green plants change light energy into…",
                  "choices": [
                    "chemical potential energy in food",
                    "sound energy",
                    "elastic energy"
                  ],
                  "answer": "chemical potential energy in food",
                  "explain": "Photosynthesis stores light energy as food."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "energyChange"
          }
        },
        {
          "skillId": "sci6-photosynthesis",
          "title": "Photosynthesis",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Put a water plant under bright light. Tiny bubbles of gas rise from its leaves.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🌿 🫧",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "In photosynthesis, chlorophyll traps light energy to turn water and carbon dioxide into sugar, giving out oxygen.",
                "visual": {
                  "kind": "letters",
                  "text": "light + water + carbon dioxide → sugar + oxygen",
                  "label": "light + water + carbon dioxide → sugar + oxygen"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: Why is photosynthesis important to animals?",
                "interact": {
                  "kind": "check",
                  "prompt": "Why is photosynthesis important to animals?",
                  "choices": [
                    "It makes the food and oxygen that animals need.",
                    "It makes carbon dioxide for animals.",
                    "It makes rain."
                  ],
                  "answer": "It makes the food and oxygen that animals need.",
                  "explain": "Almost all food chains start with green plants or algae, and they give out oxygen."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "photosynthesis"
          }
        }
      ]
    },
    {
      "topicId": "sci6-forces",
      "title": "Forces",
      "icon": "🏋️",
      "summary": "Gravity, friction and springs.",
      "skills": [
        {
          "skillId": "sci6-forces",
          "title": "Kinds of forces",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Drop a ball, slide a book across a table, and stretch a spring. Each one is a force at work.",
                "visual": {
                  "kind": "letters",
                  "emoji": "⚽ 📕",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "A force is a push or a pull, measured in newtons. Gravity pulls things down. Friction acts against motion. A spring pushes or pulls back. Forces can change speed, direction or shape."
              },
              {
                "stage": "apply",
                "text": "Your turn: Which tool measures force?",
                "interact": {
                  "kind": "check",
                  "prompt": "Which tool measures force?",
                  "choices": [
                    "a spring balance",
                    "a thermometer",
                    "a measuring cylinder"
                  ],
                  "answer": "a spring balance",
                  "explain": "A spring balance stretches more with a bigger force."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "forces"
          }
        },
        {
          "skillId": "sci6-friction",
          "title": "Friction",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Slide a toy car on a carpet, then on smooth tiles. Where does it go farther?",
                "visual": {
                  "kind": "letters",
                  "emoji": "🚗",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Friction is greater between rough surfaces and smaller between smooth or oiled ones. It is useful (walking, braking) but also wears things out and makes heat."
              },
              {
                "stage": "apply",
                "text": "Your turn: Which is an unwanted effect of friction?",
                "interact": {
                  "kind": "check",
                  "prompt": "Which is an unwanted effect of friction?",
                  "choices": [
                    "It wears out the soles of shoes.",
                    "It helps cars to brake.",
                    "It lets us hold a pencil."
                  ],
                  "answer": "It wears out the soles of shoes.",
                  "explain": "Rubbing wears surfaces away over time."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "friction"
          }
        },
        {
          "skillId": "sci6-spring",
          "title": "Springs and stretch",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Hang masses on a spring, 100 g at a time, and measure its length each time.",
                "visual": {
                  "kind": "letters",
                  "emoji": "⚖️",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "A spring stretches by the same amount for each equal mass, as long as it is not stretched past its limit. Find the stretch for 100 g, then use it to predict."
              },
              {
                "stage": "apply",
                "text": "Your turn: What mass will make the spring 23 cm long, in g?",
                "interact": {
                  "kind": "check",
                  "prompt": "What mass will make the spring 23 cm long, in g?",
                  "visual": {
                    "kind": "table",
                    "title": "Masses hung on a spring",
                    "head": [
                      "Mass (g)",
                      "Length of spring (cm)"
                    ],
                    "rows": [
                      [
                        "0",
                        "11"
                      ],
                      [
                        "100",
                        "13"
                      ],
                      [
                        "200",
                        "15"
                      ],
                      [
                        "300",
                        "17"
                      ]
                    ]
                  },
                  "choices": [
                    "500",
                    "600",
                    "700"
                  ],
                  "answer": "600",
                  "explain": "It must stretch 23 − 11 = 12 cm. At 2 cm for each 100 g, that is 6 × 100 g = 600 g."
                }
              }
            ]
          },
          "generator": {
            "type": "springStretch"
          }
        }
      ]
    },
    {
      "topicId": "sci6-environment",
