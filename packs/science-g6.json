      "icon": "🌏",
      "summary": "Food chains, habitats, adaptations and caring for the environment.",
      "skills": [
        {
          "skillId": "sci6-food-chains",
          "title": "Food chains",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "In a rice field, rats eat the rice, snakes eat the rats, and hawks eat the snakes.",
                "visual": {
                  "kind": "letters",
                  "text": "rice plant → rat → snake → hawk",
                  "label": "rice plant → rat → snake → hawk"
                }
              },
              {
                "stage": "explain",
                "text": "A food chain starts with a producer, such as a green plant or algae. Each arrow points to the animal that eats it. Animals are consumers."
              },
              {
                "stage": "apply",
                "text": "Your turn: Which animal in this food chain is not eaten by any other?",
                "interact": {
                  "kind": "check",
                  "prompt": "Which animal in this food chain is not eaten by any other?",
                  "visual": {
                    "kind": "letters",
                    "text": "algae → shrimp → small fish → kingfisher",
                    "emoji": "🌿",
                    "label": "algae → shrimp → small fish → kingfisher"
                  },
                  "choices": [
                    "small fish",
                    "shrimp",
                    "kingfisher"
                  ],
                  "answer": "kingfisher",
                  "explain": "Nothing in this chain eats the kingfisher. It is at the end of the chain."
                }
              }
            ]
          },
          "generator": {
            "type": "foodChain",
            "forms": [
              "producer",
              "eats",
              "eatenBy",
              "top"
            ]
          }
        },
        {
          "skillId": "sci6-ecosystem",
          "title": "Habitats and communities",
          "lesson": {
            "steps": [
              {
                "stage": "explain",
                "text": "A population is all of one kind of living thing in a place. A community is all the populations living together. The habitat is the place. Decomposers break down dead things.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🐟 🐸 🌿 🍄",
                  "label": "a picture"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: An animal that is hunted and eaten is called…",
                "interact": {
                  "kind": "check",
                  "prompt": "An animal that is hunted and eaten is called…",
                  "choices": [
                    "prey",
                    "a predator",
                    "a producer"
                  ],
                  "answer": "prey",
                  "explain": "A mouse is the prey of an owl."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "ecosystem"
          }
        },
        {
          "skillId": "sci6-adaptations",
          "title": "Adaptations",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Why does a duck have webbed feet, and an eagle sharp claws?",
