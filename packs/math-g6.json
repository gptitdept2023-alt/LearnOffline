        {
          "skillId": "g6-frac-divide",
          "title": "Divide fractions",
          "lesson": {
            "steps": [
              {
                "stage": "concrete",
                "text": "2 ÷ 1/4: how many fourths are in 2 wholes? Each whole has 4, so 2 × 4 = 8.",
                "visual": {
                  "kind": "stack",
                  "items": [
                    {
                      "kind": "fraction",
                      "numerator": 4,
                      "denominator": 4,
                      "shape": "bar",
                      "label": "1 whole"
                    },
                    {
                      "kind": "fraction",
                      "numerator": 4,
                      "denominator": 4,
                      "shape": "bar",
                      "label": "1 whole"
                    }
                  ]
                }
              },
              {
                "stage": "pictorial",
                "text": "So dividing by 1/4 is the same as multiplying by 4, its flip."
              },
              {
                "stage": "abstract",
                "text": "To divide by a fraction, multiply by its flip: 3/4 ÷ 3/8 = 3/4 × 8/3 = 24/12 = 2."
              },
              {
                "stage": "technique",
                "text": "Watch how: 5 ÷ 1/10 = ?",
                "interact": {
                  "kind": "worked",
                  "method": {
                    "kind": "divideFractions",
                    "n1": 5,
                    "d1": 1,
                    "n2": 1,
                    "d2": 10
                  }
                }
              },
              {
                "stage": "try",
                "text": "Your turn: 1/9 ÷ 3 = ?",
                "interact": {
                  "kind": "tryIt",
                  "method": {
                    "kind": "divideFractions",
                    "n1": 1,
                    "d1": 9,
                    "n2": 3,
                    "d2": 1,
                    "answer": "1/27"
                  }
                }
              }
            ]
          },
          "generator": {
            "type": "fractionDivide"
          }
        }
      ]
