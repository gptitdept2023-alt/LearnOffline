        {
          "skillId": "g6-frac-add-sub",
          "title": "Add and subtract fractions",
          "lesson": {
            "steps": [
              {
                "stage": "pictorial",
                "text": "Make the parts the same size first. Find the smallest number both bottom numbers go into."
              },
              {
                "stage": "abstract",
                "text": "3/4 + 5/6: 4 and 6 both go into 12. 9/12 + 10/12 = 19/12 = 1 7/12."
              },
              {
                "stage": "technique",
                "text": "Watch how: 5/6 + 5/9 = ?",
                "interact": {
                  "kind": "worked",
                  "method": {
                    "kind": "unlikeDenominator",
                    "n1": 5,
                    "d1": 6,
                    "n2": 5,
                    "d2": 9,
                    "op": "+"
                  }
                }
              },
              {
                "stage": "try",
                "text": "Your turn: 2/3 − 1/7 = ?",
                "interact": {
                  "kind": "tryIt",
                  "method": {
                    "kind": "unlikeDenominator",
                    "n1": 2,
                    "d1": 3,
                    "n2": 1,
                    "d2": 7,
                    "op": "−",
                    "answer": "11/21"
                  }
                }
              }
            ]
          },
          "generator": {
            "type": "fractionUnlike",
            "maxDen": 12
          }
        },
        {
          "skillId": "g6-frac-times",
          "title": "Multiply fractions",
          "lesson": {
            "steps": [
              {
                "stage": "abstract",
                "text": "Multiply the tops and multiply the bottoms, then simplify: 3/4 × 2/5 = 6/20 = 3/10."
              },
              {
                "stage": "technique",
                "text": "Watch how: 10/11 × 9/10 = ?",
                "interact": {
                  "kind": "worked",
                  "method": {
                    "kind": "multiplyFractions",
                    "n1": 10,
                    "d1": 11,
                    "n2": 9,
                    "d2": 10
                  }
                }
              },
              {
                "stage": "try",
                "text": "Your turn: 6/11 × 2/5 = ?",
                "interact": {
                  "kind": "tryIt",
                  "method": {
                    "kind": "multiplyFractions",
                    "n1": 6,
                    "d1": 11,
                    "n2": 2,
