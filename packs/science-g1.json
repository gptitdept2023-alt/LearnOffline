  "topics": [
    {
      "topicId": "sci1-me",
      "title": "My body and senses",
      "icon": "🖐️",
      "summary": "Body parts and the five senses.",
      "skills": [
        {
          "skillId": "sci1-senses",
          "title": "My five senses",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Close your eyes. What can you hear? What can you smell? Our senses tell us about the world around us.",
                "visual": {
                  "kind": "letters",
                  "emoji": "👀 👂 👃 👅 🖐️",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "We have five senses. We see with our eyes, hear with our ears, smell with our nose, taste with our tongue and feel with our skin.",
                "visual": {
                  "kind": "letters",
                  "text": "see · hear · smell · taste · touch",
                  "label": "see · hear · smell · taste · touch"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: Which sense tells you that bread is baking in the next room?",
                "interact": {
                  "kind": "check",
                  "prompt": "Which sense tells you that bread is baking in the next room?",
                  "visual": {
                    "kind": "letters",
                    "emoji": "🍞",
                    "label": "a picture"
                  },
                  "choices": [
                    "smell",
                    "touch",
                    "taste"
                  ],
                  "answer": "smell",
                  "explain": "You can smell bread baking even from another room."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "senses"
          }
        },
        {
          "skillId": "sci1-body",
          "title": "Parts of my body",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Touch your head, your shoulders, your knees and your toes. Each part of your body has a job.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🙆",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Your legs help you walk. Your teeth chew food. Inside, your heart pumps blood and your lungs take in air.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🦵 🦷 ❤️ 🫁",
                  "label": "a picture"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: What helps you think and remember?",
                "interact": {
                  "kind": "check",
                  "prompt": "What helps you think and remember?",
                  "choices": [
                    "brain",
                    "stomach",
                    "knee"
                  ],
                  "answer": "brain",
                  "explain": "Your brain is inside your head. It helps you think, learn and remember."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "body"
          }
        }
      ]
    },
    {
      "topicId": "sci1-living",
      "title": "Living things",
      "icon": "🌱",
      "summary": "What is alive, and what living things need.",
      "skills": [
        {
          "skillId": "sci1-living-sort",
          "title": "Living or non-living?",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "A puppy grows into a dog. A rock stays a rock. Which one is alive?",
                "visual": {
                  "kind": "letters",
                  "emoji": "🐶 🪨",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Living things grow, need food, water and air, and make young like themselves. A robot can move, but it does not grow or eat, so it is non-living.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🌳 🐦 · 🤖 ⚽",
                  "label": "a picture"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: Is it living or non-living?",
                "interact": {
                  "kind": "check",
                  "prompt": "Is it living or non-living?",
                  "visual": {
                    "kind": "letters",
                    "emoji": "👶",
                    "text": "baby",
                    "label": "baby"
                  },
                  "choices": [
                    "living",
                    "non-living"
                  ],
                  "answer": "living",
                  "explain": "A baby is a living thing: it grows, needs food, water and air, and makes young like itself."
                }
              }
            ]
          },
          "generator": {
            "type": "sciSort",
            "set": "living"
          }
        },
        {
          "skillId": "sci1-needs",
          "title": "What living things need",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "What happens to a plant that is never watered? It droops and dries up.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🥀",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "All living things need food, water and air. Plants also need sunlight to make their food. Animals and people need shelter too.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🍎 💧 💨 ☀️",
                  "label": "a picture"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: Why do we drink water every day?",
                "interact": {
                  "kind": "check",
                  "prompt": "Why do we drink water every day?",
                  "visual": {
                    "kind": "letters",
                    "emoji": "💧",
                    "label": "a picture"
                  },
                  "choices": [
                    "Our bodies need water to stay alive.",
                    "Water makes our hair longer.",
                    "We only need it when we are sick."
                  ],
                  "answer": "Our bodies need water to stay alive.",
                  "explain": "Our bodies use water all the time, so we drink it every day."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "needs"
          }
        }
      ]
    },
    {
