          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Watch how animals move: a bird flies, a fish swims, a frog hops and a snake slides.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🐦 🐟 🐸 🐍",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "An animal's body helps it move. Wings help birds fly. Fins help fish swim. Strong back legs help frogs hop."
              },
              {
                "stage": "apply",
                "text": "Your turn: Which body parts help a bird fly?",
                "interact": {
                  "kind": "check",
