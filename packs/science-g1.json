          "title": "Animal babies",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "A kitten grows into a cat. A puppy grows into a dog.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🐱 🐶",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Many animal babies have special names: a chick, a calf, a duckling. Some babies, like tadpoles and caterpillars, look very different from their parents.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🐣 🐄 🐛",
                  "label": "a picture"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: A baby butterfly is called a…",
                "interact": {
                  "kind": "check",
                  "prompt": "A baby butterfly is called a…",
                  "visual": {
                    "kind": "letters",
                    "emoji": "🦋",
                    "label": "a picture"
                  },
                  "choices": [
                    "caterpillar",
                    "tadpole",
