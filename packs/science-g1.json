    {
      "topicId": "sci1-plants",
      "title": "Plants",
      "icon": "🌻",
      "summary": "The parts of a plant, and the plant parts we eat.",
      "skills": [
        {
          "skillId": "sci1-plant-parts",
          "title": "Parts of a plant",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Look at a plant. Roots are under the soil. The stem stands up. Leaves are green and flat.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🌱",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Roots hold the plant and take in water. The stem holds it up. Leaves make food. Flowers grow into fruits, and fruits hold seeds.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🌸 🍎 🌰",
                  "label": "a picture"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: Water goes up the plant through the…",
                "interact": {
                  "kind": "check",
                  "prompt": "Water goes up the plant through the…",
                  "choices": [
                    "stem",
                    "flower",
                    "fruit"
                  ],
                  "answer": "stem",
                  "explain": "The stem carries water up from the roots to the leaves."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "plantParts1"
          }
        },
        {
          "skillId": "sci1-plant-food",
          "title": "Plants we eat",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "A carrot grows under the ground. Pechay leaves grow above it. Both are plants we eat!",
                "visual": {
                  "kind": "letters",
                  "emoji": "🥕 🥬",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "We eat different parts of plants: roots like carrots, leaves like pechay, flowers like broccoli, fruits like mangoes, and seeds like peanuts.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🥦 🥭 🥜",
                  "label": "a picture"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: Which part of the plant do we eat?",
                "interact": {
                  "kind": "check",
                  "prompt": "Which part of the plant do we eat?",
                  "visual": {
                    "kind": "letters",
                    "text": "radish (labanos)",
                    "label": "radish (labanos)"
                  },
                  "choices": [
                    "stem",
                    "root",
                    "leaf",
                    "flower"
                  ],
                  "answer": "root",
                  "explain": "A radish (labanos) is a root we eat: it grows under the ground and stores food for the plant."
                }
              }
            ]
          },
          "generator": {
            "type": "sciSort",
