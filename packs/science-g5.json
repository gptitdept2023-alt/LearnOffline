          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "A coconut can float across the sea to a new island. Why do seeds need to travel?",
                "visual": {
                  "kind": "letters",
                  "emoji": "🥥 🌊",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Seeds spread away from the parent plant so the young plants get enough light, water and space. They travel by wind, water, animals, or by pods splitting open."
              },
              {
                "stage": "apply",
                "text": "Your turn: How are its seeds mainly spread?",
                "interact": {
