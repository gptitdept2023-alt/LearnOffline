      "topicId": "sci5-cells",
      "title": "Cells",
      "icon": "🔬",
      "summary": "Parts of a cell; plant and animal cells.",
      "skills": [
        {
          "skillId": "sci5-cell-parts",
          "title": "Parts of a cell",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Under a microscope, a thin onion skin shows rows of tiny boxes. Each box is a cell.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🔬 🧅",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "The nucleus controls the cell. The cell membrane controls what goes in and out. Most activities happen in the cytoplasm. Plant cells also have a cell wall, a large vacuole and often chloroplasts."
              },
              {
                "stage": "apply",
                "text": "Your turn: Which tool do we use to see cells?",
                "interact": {
                  "kind": "check",
                  "prompt": "Which tool do we use to see cells?",
                  "choices": [
                    "a microscope",
                    "a telescope",
                    "a thermometer"
                  ],
                  "answer": "a microscope",
                  "explain": "Most cells are too small to see without a microscope."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "cellParts"
          }
        },
        {
          "skillId": "sci5-cell-compare",
          "title": "Plant and animal cells",
          "lesson": {
            "steps": [
              {
                "stage": "explain",
                "text": "Plant and animal cells both have a nucleus, cytoplasm and cell membrane. Only plant cells have a cell wall. Cells in green parts of plants have chloroplasts to make food.",
                "visual": {
                  "kind": "letters",
                  "text": "plant cell: + cell wall + chloroplasts",
                  "label": "plant cell: + cell wall + chloroplasts"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: Plant cells usually have one large…",
                "interact": {
                  "kind": "check",
                  "prompt": "Plant cells usually have one large…",
                  "choices": [
                    "vacuole",
                    "chloroplast",
                    "nucleus"
                  ],
                  "answer": "vacuole",
                  "explain": "The large vacuole holds cell sap and helps keep the cell firm."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "cellCompare"
          }
        }
      ]
    },
    {
      "topicId": "sci5-body",
      "title": "Body systems",
      "icon": "❤️",
      "summary": "Breathing, the heart and blood, and how systems work together.",
      "skills": [
        {
          "skillId": "sci5-respiratory",
          "title": "Breathing",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Put your hand on your chest and breathe in deeply. Your chest rises as your lungs fill with air.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🫁",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Air goes in through the nose, down the windpipe, into the lungs. In the tiny air sacs, oxygen passes into the blood and carbon dioxide passes out."
              },
              {
                "stage": "apply",
                "text": "Your turn: Fish take in oxygen from water using their…",
                "interact": {
                  "kind": "check",
                  "prompt": "Fish take in oxygen from water using their…",
                  "visual": {
                    "kind": "letters",
                    "emoji": "🐟",
                    "label": "a picture"
                  },
                  "choices": [
                    "gills",
                    "lungs",
                    "fins"
                  ],
                  "answer": "gills",
                  "explain": "Gills take in oxygen dissolved in water."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "respiratory"
          }
        },
        {
          "skillId": "sci5-circulatory",
          "title": "The heart and blood",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Count your pulse for 15 seconds. Jump for a minute, then count again. It is faster!",
                "visual": {
                  "kind": "letters",
                  "emoji": "❤️ ⏱️",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "The heart pumps blood. Arteries carry it away from the heart, capillaries reach every cell, and veins bring it back. Blood carries oxygen, food and carbon dioxide."
              },
              {
                "stage": "apply",
                "text": "Your turn: Where does blood pick up oxygen?",
                "interact": {
                  "kind": "check",
                  "prompt": "Where does blood pick up oxygen?",
                  "choices": [
                    "in the lungs",
                    "in the stomach",
                    "in the brain"
                  ],
                  "answer": "in the lungs",
                  "explain": "Oxygen passes from the air sacs into the blood."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "circulatory"
          }
        },
        {
          "skillId": "sci5-paths",
          "title": "Follow the path",
          "lesson": {
            "steps": [
              {
                "stage": "explain",
                "text": "Air path: nose → windpipe → lungs → air sacs → blood. Blood path: heart → arteries → capillaries → veins → back to the heart."
              },
              {
                "stage": "apply",
                "text": "Your turn: In the path of air into the body, what comes just before \"windpipe\"?",
                "interact": {
                  "kind": "check",
                  "prompt": "In the path of air into the body, what comes just before \"windpipe\"?",
                  "visual": {
                    "kind": "letters",
                    "emoji": "🫁",
                    "label": "the path of air into the body"
                  },
                  "choices": [
                    "blood",
                    "air sacs",
                    "nose",
                    "lungs"
                  ],
                  "answer": "nose",
                  "explain": "The path of air into the body: nose → windpipe → lungs → air sacs → blood."
                }
              }
            ]
          },
          "generator": {
            "type": "sciOrder",
            "seqs": [
              "airPath",
              "bloodPath"
