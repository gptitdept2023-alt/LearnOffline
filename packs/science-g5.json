        {
          "skillId": "sci5-flowers",
          "title": "Flowers and pollination",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Look at a gumamela flower. The long stalk in the middle is covered with many tiny stamens; their yellow dust is pollen. The five fuzzy red pads at the tip are the stigma.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🌺",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Pollination: pollen from an anther lands on a stigma. Fertilisation: a male cell joins an egg in the ovule. Then the ovary becomes the fruit and the ovules become seeds.",
                "visual": {
                  "kind": "letters",
                  "text": "pollination → fertilisation → fruit and seeds",
                  "label": "pollination → fertilisation → fruit and seeds"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: Which part becomes the seed?",
                "interact": {
                  "kind": "check",
                  "prompt": "Which part becomes the seed?",
                  "choices": [
                    "the anther",
                    "the ovary",
                    "the ovule"
                  ],
                  "answer": "the ovule",
                  "explain": "Each fertilised ovule becomes a seed inside the fruit."
                }
              }
            ]
          },
          "generator": {
