      "skills": [
        {
          "skillId": "g3-place-value",
          "title": "Place value to thousands",
          "lesson": {
            "steps": [
              {
                "stage": "pictorial",
                "text": "Each place is 10 times the place on its right: ones, tens, hundreds, thousands. In 5,284 the 5 stands for 5,000."
              },
              {
                "stage": "abstract",
                "text": "Your turn: What digit is in the thousands place in 4,728?",
                "interact": {
                  "kind": "check",
                  "prompt": "What digit is in the thousands place in 4,728?",
                  "choices": [
                    "3",
                    "4",
                    "5"
                  ],
                  "answer": "4",
                  "explain": "The answer is 4."
                }
              }
            ]
          },
          "generator": {
            "type": "placeValue",
            "digits": 4
          }
        },
        {
          "skillId": "g3-compare",
          "title": "Compare numbers",
          "lesson": {
            "steps": [
              {
                "stage": "abstract",
                "text": "Start from the thousands. The first place where the digits differ tells you which is greater."
              },
              {
                "stage": "abstract",
                "text": "Your turn: Which number is greater?",
                "interact": {
                  "kind": "check",
                  "prompt": "Which number is greater?",
                  "choices": [
                    "2,378",
                    "6,757"
                  ],
                  "answer": "6,757",
                  "explain": "The answer is 6,757."
                }
              }
            ]
          },
          "generator": {
            "type": "compare",
            "min": 1000,
            "max": 9999
          }
        },
        {
          "skillId": "g3-add-sub",
          "title": "Add and subtract to 10,000",
          "lesson": {
            "steps": [
              {
                "stage": "abstract",
                "text": "Line up the places. Work from the ones. Carry when a place makes 10 or more, rename when the top digit is too small."
              },
              {
                "stage": "technique",
                "text": "Watch how: 6,552 − 4,496 = ?",
                "interact": {
                  "kind": "worked",
                  "method": {
                    "kind": "columnSub",
                    "a": 6552,
                    "b": 4496
                  }
                }
              },
              {
                "stage": "try",
                "text": "Your turn: 2,096 + 1,581 = ?",
                "interact": {
                  "kind": "tryIt",
                  "method": {
                    "kind": "columnAdd",
                    "a": 2096,
                    "b": 1581,
                    "answer": 3677
                  }
                }
              }
            ]
          },
