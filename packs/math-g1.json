                  "kind": "check",
                  "prompt": "What digit is in the tens place in 47?",
                  "visual": {
                    "kind": "blocks",
                    "value": 47
                  },
                  "choices": [
                    "3",
                    "4",
                    "5"
                  ],
                  "answer": "4",
                  "explain": "The answer is 4."
