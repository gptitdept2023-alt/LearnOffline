          "title": "Tens and ones",
          "lesson": {
            "steps": [
              {
                "stage": "concrete",
                "text": "A rod is 10 cubes joined together. 47 is 4 rods and 7 cubes.",
                "visual": {
                  "kind": "blocks",
                  "value": 47
