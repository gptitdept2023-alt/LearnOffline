      "topicId": "sci4-matter",
      "title": "Matter",
      "icon": "🧪",
      "summary": "Mass and volume; solids, liquids and gases.",
      "skills": [
        {
          "skillId": "sci4-matter",
          "title": "What is matter?",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Push an upside-down empty cup into a basin of water. Why does the water not go in?",
                "visual": {
                  "kind": "letters",
                  "emoji": "🥛 💧",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Matter is anything that has mass and takes up space. Air is matter: it fills the cup. Light, heat and sound are not matter."
              },
              {
                "stage": "apply",
                "text": "Your turn: Heat is…",
                "interact": {
                  "kind": "check",
                  "prompt": "Heat is…",
                  "choices": [
                    "a form of energy, not matter",
                    "a kind of gas",
                    "a kind of liquid"
                  ],
                  "answer": "a form of energy, not matter",
                  "explain": "Heat is energy. It has no mass."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "matter"
          }
        },
        {
          "skillId": "sci4-states",
          "title": "Properties of solids, liquids and gases",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Pour 200 ml of water from a tall glass into a wide bowl. Push the plunger of a syringe (with no needle) full of air, then one full of water.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🥛 🥣",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "A solid has a fixed shape and volume. A liquid has a fixed volume but takes the shape of its container. A gas has no fixed shape or volume and can be compressed."
              },
              {
                "stage": "apply",
                "text": "Your turn: A gas spreads out to…",
                "interact": {
                  "kind": "check",
                  "prompt": "A gas spreads out to…",
                  "choices": [
                    "fill all the space in its container",
                    "the bottom of its container only",
                    "make a fixed shape"
                  ],
                  "answer": "fill all the space in its container",
                  "explain": "A gas fills any container completely."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "statesProps"
          }
        },
        {
          "skillId": "sci4-volume",
          "title": "Measuring volume",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "A measuring cylinder has 50 ml of water. Drop in a stone. The water rises to 65 ml.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🧪",
                  "text": "50 ml → 65 ml",
                  "label": "50 ml → 65 ml"
                }
              },
              {
                "stage": "explain",
                "text": "The stone pushes aside water equal to its own volume. 65 − 50 = 15 ml, and 1 ml takes up 1 cm³, so the stone's volume is 15 cm³."
              },
              {
                "stage": "apply",
                "text": "Your turn: A measuring cylinder has 55 ml of water. A metal toy car is put in and the water rises to 70 ml. What is the volume of the metal toy car, in cm³?",
                "interact": {
                  "kind": "check",
                  "prompt": "A measuring cylinder has 55 ml of water. A metal toy car is put in and the water rises to 70 ml. What is the volume of the metal toy car, in cm³?",
                  "visual": {
                    "kind": "letters",
                    "text": "55 ml → 70 ml",
                    "emoji": "🧪",
                    "label": "55 ml → 70 ml"
                  },
                  "choices": [
                    "14",
                    "15",
                    "16"
                  ],
                  "answer": "15",
                  "explain": "70 ml − 55 ml = 15 ml, and 1 ml takes up 1 cm³. The metal toy car has a volume of 15 cm³."
                }
              }
            ]
          },
          "generator": {
            "type": "displacement"
          }
        }
      ]
    },
    {
      "topicId": "sci4-changes",
      "title": "Changes of state",
      "icon": "💧",
      "summary": "Melting, freezing, evaporation, condensation and the water cycle.",
      "skills": [
        {
          "skillId": "sci4-change-names",
          "title": "Melting, freezing, evaporating",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Leave an ice cube on a plate. Put a glass of iced water on the table and watch its outside.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🧊 🥤",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Gaining heat: solids melt and liquids evaporate (or boil). Losing heat: gases condense and liquids freeze. Pure water freezes at 0 °C and boils at 100 °C.",
                "visual": {
                  "kind": "letters",
                  "text": "solid ⇄ liquid ⇄ gas",
                  "label": "solid ⇄ liquid ⇄ gas"
                }
              },
              {
                "stage": "apply",
                "text": "Your turn: Water vapour loses heat and changes into water. This is…",
                "interact": {
                  "kind": "check",
                  "prompt": "Water vapour loses heat and changes into water. This is…",
                  "choices": [
                    "condensation",
                    "evaporation",
                    "melting"
                  ],
                  "answer": "condensation",
                  "explain": "Condensation is a gas changing into a liquid when it loses heat."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "changeState"
          }
        },
        {
          "skillId": "sci4-water-cycle",
          "title": "The water cycle",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Puddles disappear on a sunny day. Where does the water go?",
                "visual": {
                  "kind": "letters",
                  "emoji": "☀️ 💧 ☁️",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "The Sun heats water, which evaporates. The water vapour rises, cools and condenses into clouds. The droplets join and fall as rain, and the cycle repeats."
              },
              {
                "stage": "apply",
                "text": "Your turn: In the water cycle, what comes just before \"the Sun heats water in seas and rivers\"?",
                "interact": {
                  "kind": "check",
                  "prompt": "In the water cycle, what comes just before \"the Sun heats water in seas and rivers\"?",
                  "visual": {
                    "kind": "letters",
                    "emoji": "💧",
                    "label": "the water cycle"
                  },
                  "choices": [
                    "it condenses into clouds",
                    "water vapour rises and cools",
                    "rain falls back to the Earth",
                    "the water evaporates"
                  ],
                  "answer": "rain falls back to the Earth",
                  "explain": "The water cycle: the Sun heats water in seas and rivers → the water evaporates → water vapour rises and cools → it condenses into clouds → rain falls back to the Earth, and then it starts again. The rain flows back to seas and rivers, and the cycle starts again."
                }
              }
            ]
          },
          "generator": {
            "type": "sciOrder",
            "seqs": [
              "waterCycle"
            ]
          }
        },
        {
          "skillId": "sci4-melt-boil",
          "title": "Melting and boiling points",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Butter melts on a hot day. Ice melts even in a cool room. Each substance melts and boils at its own temperatures.",
                "visual": {
                  "kind": "letters",
                  "emoji": "🧈 🧊",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Below its melting point, a substance is a solid. Between its melting and boiling points, it is a liquid. Above its boiling point, it is a gas."
              },
              {
                "stage": "apply",
                "text": "Your turn: What is substance A at 12 °C?",
                "interact": {
                  "kind": "check",
                  "prompt": "What is substance A at 12 °C?",
                  "visual": {
                    "kind": "table",
                    "title": "Melting and boiling points",
                    "head": [
                      "Substance",
                      "Melting point (°C)",
                      "Boiling point (°C)"
                    ],
                    "rows": [
                      [
                        "A",
                        "-30",
                        "150"
                      ],
                      [
                        "B",
                        "-95",
                        "0"
                      ],
                      [
                        "C",
                        "-20",
                        "55"
                      ],
                      [
                        "D",
                        "90",
                        "115"
                      ]
                    ]
                  },
                  "choices": [
                    "solid",
                    "liquid",
                    "gas"
                  ],
                  "answer": "liquid",
                  "explain": "12 °C is between its melting point (-30 °C) and boiling point (150 °C), so substance A is a liquid."
                }
              }
            ]
          },
          "generator": {
            "type": "stateAtTemp"
          }
        }
