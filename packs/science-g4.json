    {
      "topicId": "sci4-heat",
      "title": "Heat",
      "icon": "🔥",
      "summary": "Heat and temperature; good and poor conductors.",
      "skills": [
        {
          "skillId": "sci4-heat",
          "title": "Heat and temperature",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Ask an adult to pour hot water into a bowl. Drop in a dented ping-pong ball. The dent pops out!",
                "visual": {
                  "kind": "letters",
                  "emoji": "🏓 ♨️",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Heat flows from hotter to colder things. When things gain heat they usually expand; when they lose heat they contract. A thermometer measures temperature in °C."
              },
              {
                "stage": "apply",
                "text": "Your turn: A cup of hot chocolate is left on the table. What happens?",
                "interact": {
                  "kind": "check",
                  "prompt": "A cup of hot chocolate is left on the table. What happens?",
                  "visual": {
                    "kind": "letters",
                    "emoji": "☕",
                    "label": "a picture"
                  },
                  "choices": [
                    "It loses heat to the air until it is as warm as the room.",
                    "It gets hotter.",
                    "It gains heat from the air."
                  ],
                  "answer": "It loses heat to the air until it is as warm as the room.",
                  "explain": "Heat flows from the hot drink to the cooler air."
                }
              }
            ]
          },
          "generator": {
            "type": "sciQuiz",
            "bank": "heat"
          }
        },
        {
          "skillId": "sci4-conductors",
          "title": "Good and poor conductors of heat",
          "lesson": {
            "steps": [
              {
                "stage": "observe",
                "text": "Ask an adult to pour hot water into a cup, then stand a metal spoon and a wooden spoon in it. After a minute, which handle is warmer?",
                "visual": {
                  "kind": "letters",
                  "emoji": "🥄 ☕",
                  "label": "a picture"
                }
              },
              {
                "stage": "explain",
                "text": "Metals are good conductors of heat. Wood, plastic, cloth, rubber, foam and trapped air are poor conductors: they slow heat down."
              },
              {
                "stage": "apply",
                "text": "Your turn: Is it a good or a poor conductor of heat?",
                "interact": {
                  "kind": "check",
                  "prompt": "Is it a good or a poor conductor of heat?",
                  "visual": {
                    "kind": "letters",
                    "emoji": "🍳",
                    "text": "an iron pan",
                    "label": "an iron pan"
                  },
                  "choices": [
                    "good conductor of heat",
                    "poor conductor of heat"
                  ],
                  "answer": "good conductor of heat",
                  "explain": "An iron pan is a good conductor of heat: it is a metal, and heat passes through metals quickly."
                }
              }
            ]
          },
          "generator": {
            "type": "sciSort",
            "set": "heatConductors"
          }
        }
